{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reach",
  "version": "0.3.0",
  "identifier": "dev.reach.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{ "title": "Reach", "width": 1200, "height": 780, "minWidth": 900, "minHeight": 600, "visible": false }],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": { "../prompts/agent_system.md": "prompts/agent_system.md" },
    "windows": { "nsis": { "installerIcon": "icons/icon.ico" } }
  }
}
